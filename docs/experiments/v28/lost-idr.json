  "scope": {
    "time": "media arrival, feedback and playout timestamps are virtual milliseconds; codecs are real",
    "recovery": "arrival-driven sequence-gap/reference-chain recovery, independent of bitrate; bounded retries, no speculative IDRs during full media silence",
    "feedback": "ideal reliable fixed-delay reverse paths; no bandwidth/loss/control-byte model or cancellation of in-flight recovery requests",
    "coalescing": "a rate change and any IDR requests due before a source frame share one restart",
    "paired_link": "identical parameters and seed; admission changes may associate random draws with different source IDs; zero jitter/random loss is the cleaner ablation",
    "limits": "two target rates, at most 20 configured rate/recovery requests in total; no capacity estimator, network, Colab/GPU, GUI or bitrate guarantee"
  }
