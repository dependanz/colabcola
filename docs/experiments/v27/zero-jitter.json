    "feedback": "ideal reliable reverse path with a fixed delay; no reverse bandwidth/loss model or control-byte accounting",
    "watchdog": "armed by first usable arrival; no startup silence detection; disabled after the final source frame; silence is not proof of congestion",
    "paired_link": "identical parameters and seed, not necessarily identical per-frame jitter/loss draws when admission changes; use zero jitter/random loss for a cleaner ablation",
    "limits": "two target rates and encoder restarts; no capacity estimator, actual network, Colab/GPU, GUI, physical presentation or bitrate guarantee"
  }
}
